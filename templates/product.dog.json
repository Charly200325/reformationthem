(card){const url=card.dataset.src,controls=card.dataset.controls==='true',muted=card.dataset.muted==='true',loop=card.dataset.loop==='true';let p;\n if(!isYT(url)&&!isVimeo(url)){const v=warmMP4(card,url);if(!controls)v.removeAttribute('controls');else v.setAttribute('controls','');if(loop)v.setAttribute('loop','');if(muted){v.muted=true;v.setAttribute('muted','')}p={type:'mp4',el:v,card};players.push(p);\n  v.addEventListener('click',ev=>{if(controls)ev.stopPropagation()},{passive:true});\n  v.addEventListener('play',()=>{instantPlayUI(p);pauseOthers(p)},{passive:true});\n  v.addEventListener('pause',()=>{instantPauseUI(p)},{passive:true});\n  return p}\n if(isYT(url)){const id=ytId(url),src=`https://www.youtube.com/embed/${id}?enablejsapi=1&playsinline=1&rel=0&modestbranding=1&controls=${controls?1:0}&mute=${muted?1:0}&autoplay=0&loop=${loop?1:0}${loop?`&playlist=${id}`:''}`;const f=warmIframe(card,src);p={type:'youtube',el:f,card};players.push(p);return p}\n const id=vmId(url),src=`https://player.vimeo.com/video/${id}?muted=${muted?1:0}&autoplay=0&loop=${loop?1:0}&title=0&byline=0&portrait=0&playsinline=1`;const f=warmIframe(card,src);p={type:'vimeo',el:f,card};players.push(p);return p}\n\nfunction doPlay(p){if(p.type==='mp4'){p.el.play().catch(()=>{})}\n else if(p.type==='youtube'){try{p.el.contentWindow.postMessage(JSON.stringify({event:'command',func:'playVideo'}),'*')}catch{}}\n else if(p.type==='vimeo'){try{p.el.contentWindow.postMessage({method:'play'},'*')}catch{}}}\nfunction doPause(p){if(p.type==='mp4'){try{p.el.pause()}catch{}}\n else if(p.type==='youtube'){try{p.el.contentWindow.postMessage(JSON.stringify({event:'command',func:'pauseVideo'}),'*')}catch{}}\n else if(p.type==='vimeo'){try{p.el.contentWindow.postMessage({method:'pause'},'*')}catch{}}}\n\nconst io='IntersectionObserver'in window?new IntersectionObserver(es=>{es.forEach(en=>{if(!en.isIntersecting)return;const card=en.target,url=card.dataset.src;\n if(!isYT(url)&&!isVimeo(url)){warmMP4(card,