          "settings": {
            "custom_liquid": "{% assign seconds_in_day = 86400 %}\n{% assign days_to_add = 6 %}\n{% assign offset_seconds = seconds_in_day | times: days_to_add | plus: 7200 %}\n{% assign delivery_timestamp = 'now' | date: '%s' | plus: offset_seconds %}\n\n<div class=\"flex items-center justify-center xl:justify-start mt-[20px] xl:mt-[30px]\">\n  <div class=\"ml-[10px] xl:ml-[20px] text-[11px] xl:text-[14px] text-gray-900 uppercase\" style=\"line-height:1.2;\">\n    <p style=\"margin:0;padding:0;display:flex;align-items:center;gap:6px;\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" rx=\"1\"/><path d=\"M16 8h4l3 5v4h-7V8z\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/>\n      </svg>\n      Estimated delivery on {{ delivery_timestamp | date: '%A %-d %B' | upcase }}.\n    </p>\n    <p style=\"margin:0;padding:0;\">Order within <span id=\"countdown\"></span>.</p>\n  </div>\n</div>\n\n<script>\n  function updateCountdown() {\n    const now = new Date();\n    const deadline = new Date();\n    deadline.setHours(23, 59, 59, 0);\n    const diff = deadline - now;\n    if (diff <= 0) {\n      document.getElementById('countdown').textContent = '0h00min';\n      return;\n    }\n    const totalMinutes = Math.floor(diff / 1000 / 60);\n    const hours = Math.floor(totalMinutes / 60);\n    const minutes = totalMinutes % 60;\n    document.getElementById('countdown').textContent =\n      hours + 'h' + String(minutes).padStart(2, '0') + 'min';\n  }\n  updateCountdown();\n  setInterval(updateCountdown, 1000);\n</script>"
          }
